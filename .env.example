# ─────────────────────────────────────────────────────────────────────────
# All variables here are OPTIONAL. The site builds and runs with none set.
# Copy to .env.local for local overrides:  cp .env.example .env.local
# ─────────────────────────────────────────────────────────────────────────

# Absolute origin, used for <meta> / Open Graph and as the sitemap fallback.
# Set this in your host's environment settings once a real domain is attached.
# Without it the app falls back to the host variable your platform injects
# (Vercel / Netlify / Render / Cloudflare Pages), then to localhost.
#
# NOTE: robots.txt and sitemap.xml derive the origin from the request headers,
# so they are correct on any host even if this is unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# There are NO API keys, secrets, database URLs or third-party services.
# Nothing in this project requires a credential to build, run or deploy.
